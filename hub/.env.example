# EchoMe Hub Configuration
ECHOME_AUTH_TOKEN=your-secret-token-here
ECHOME_DATABASE_URL=postgresql+asyncpg://echome:echome@localhost:5432/echome
ECHOME_REDIS_URL=redis://localhost:6379/0
ECHOME_OPENAI_API_KEY=sk-your-key-here
ECHOME_EMBEDDING_MODEL=text-embedding-3-small
ECHOME_DEBUG=false

# Token limits
ECHOME_L0_MAX_TOKENS=1500
ECHOME_L0_MAX_COUNT=20
ECHOME_L1_MAX_TOKENS=2000
ECHOME_L1_MAX_COUNT=30
