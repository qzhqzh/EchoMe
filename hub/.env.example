# EchoMe Hub Configuration
# Copy this file to .env and adjust values

# Emergency auth token (optional, disabled by default)
# Set this ONLY as a fallback when GitHub OAuth is unreachable.
# When set, this token can authenticate as the first admin user.
# ECHOME_AUTH_TOKEN=your-emergency-token-here

# GitHub OAuth
ECHOME_GITHUB_CLIENT_ID=your-github-client-id
ECHOME_GITHUB_CLIENT_SECRET=your-github-client-secret

# JWT (REQUIRED - generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
ECHOME_JWT_SECRET=change-this-to-a-random-string-at-least-32-chars
ECHOME_JWT_EXPIRE_DAYS=3650

# CORS origins (comma-separated, or "*" for all)
# ECHOME_CORS_ORIGINS=https://echome.example.com,http://localhost:20001

# Database (use 'postgres' as host when running via docker-compose)
ECHOME_DATABASE_URL=postgresql+asyncpg://echome:echome@postgres:5432/echome

# Redis
ECHOME_REDIS_URL=redis://redis:6379/0

# Embedding service (self-hosted, must expose POST /embed)
# See embedding/README.md for the API contract
ECHOME_EMBEDDING_URL=http://localhost:20002
ECHOME_EMBEDDING_DIMENSIONS=1024

# Project Context Compiler (disable for a no-data-loss query rollback)
ECHOME_CONTEXT_COMPILER_ENABLED=true

# Proposal-only project automation (disabled by default)
ECHOME_PROJECT_AUTOMATION_ENABLED=false

# Debug
ECHOME_DEBUG=false

# Port (default 20000)
ECHOME_PORT=20000

# Token limits
ECHOME_L0_MAX_TOKENS=1500
ECHOME_L0_MAX_COUNT=20
ECHOME_L1_MAX_TOKENS=2000
ECHOME_L1_MAX_COUNT=30
